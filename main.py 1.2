books = {}

def add_book():
    book_id = input("Enter Book ID: ")
    title = input("Enter Book Title: ")
    author = input("Enter Author Name: ")

    books[book_id] = {
        "title": title,
        "author": author,
        "status": "Available"
    }

    print("Book Added Successfully!")

def issue_book():
    book_id = input("Enter Book ID to Issue: ")

    if book_id in books:
        if books[book_id]["status"] == "Available":
            books[book_id]["status"] = "Issued"
            print("Book Issued Successfully!")
        else:
            print("Book Already Issued!")
    else:
        print("Book Not Found!")

def return_book():
    book_id = input("Enter Book ID to Return: ")

    if book_id in books:
        books[book_id]["status"] = "Available"
        print("Book Returned Successfully!")
    else:
        print("Book Not Found!")

def search_book():
    book_id = input("Enter Book ID: ")

    if book_id in books:
        print("\nBook Details")
        print("Book ID :", book_id)
        print("Title   :", books[book_id]["title"])
        print("Author  :", books[book_id]["author"])
        print("Status  :", books[book_id]["status"])
    else:
        print("Book Not Found!")

def view_books():
    if not books:
        print("No Books Available!")
        return

    print("\n===== BOOK LIST =====")

    for book_id, details in books.items():
        print("---------------------")
        print("Book ID :", book_id)
        print("Title   :", details["title"])
        print("Author  :", details["author"])
        print("Status  :", details["status"])

def generate_report():
    total = len(books)
    issued = 0
    available = 0

    for book in books.values():
        if book["status"] == "Issued":
            issued += 1
        else:
            available += 1

    print("\n===== LIBRARY REPORT =====")
    print("Total Books     :", total)
    print("Issued Books    :", issued)
    print("Available Books :", available)

while True:
    print("\n===== LIBRARY MANAGEMENT SYSTEM =====")
    print("1. Add Book")
    print("2. Issue Book")
    print("3. Return Book")
    print("4. Search Book")
    print("5. View Books")
    print("6. Generate Report")
    print("7. Exit")

    choice = input("Enter Choice: ")

    if choice == "1":
        add_book()
    elif choice == "2":
        issue_book()
    elif choice == "3":
        return_book()
    elif choice == "4":
        search_book()
    elif choice == "5":
        view_books()
    elif choice == "6":
        generate_report()
    elif choice == "7":
        print("Thank You!")
        break
    else:
        print("Invalid Choice!")
