class Student:
    def __init__(self, roll_no, name, marks):
        self.roll_no = roll_no
        self.name = name
        self.marks = marks
        self.grade = self.calculate_grade()

    def calculate_grade(self):
        if self.marks >= 90:
            return "A"
        elif self.marks >= 80:
            return "B"
        elif self.marks >= 70:
            return "C"
        elif self.marks >= 60:
            return "D"
        else:
            return "F"

    def update_marks(self, marks):
        self.marks = marks
        self.grade = self.calculate_grade()

    def __str__(self):
        return (f"Roll No: {self.roll_no}\n"
                f"Name: {self.name}\n"
                f"Marks: {self.marks}\n"
                f"Grade: {self.grade}")


students = []


def add_student():
    roll = int(input("Roll No: "))
    name = input("Name: ")
    marks = float(input("Marks: "))

    students.append(Student(roll, name, marks))
    print("Student Added Successfully!")


def view_students():
    if not students:
        print("No Records Found!")
        return

    for s in students:
        print("\n----------------")
        print(s)


def search_student():
    roll = int(input("Enter Roll No: "))

    for s in students:
        if s.roll_no == roll:
            print(s)
            return

    print("Student Not Found!")


def update_student():
    roll = int(input("Enter Roll No: "))

    for s in students:
        if s.roll_no == roll:
            marks = float(input("New Marks: "))
            s.update_marks(marks)
            print("Record Updated Successfully!")
            return

    print("Student Not Found!")


def delete_student():
    roll = int(input("Enter Roll No: "))

    for s in students:
        if s.roll_no == roll:
            students.remove(s)
            print("Record Deleted Successfully!")
            return

    print("Student Not Found!")


while True:

    print("\n===== STUDENT GRADE MANAGEMENT SYSTEM =====")
    print("1. Add Student")
    print("2. View Students")
    print("3. Search Student")
    print("4. Update Student")
    print("5. Delete Student")
    print("6. Exit")

    choice = int(input("Enter Choice: "))

    if choice == 1:
        add_student()

    elif choice == 2:
        view_students()

    elif choice == 3:
        search_student()

    elif choice == 4:
        update_student()

    elif choice == 5:
        delete_student()

    elif choice == 6:
        print("Thank You!")
        break

    else:
        print("Invalid Choice!")
