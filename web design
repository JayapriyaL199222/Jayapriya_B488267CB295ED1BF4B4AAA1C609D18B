<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasty Restaurant</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <h1>Tasty Restaurant</h1>
    <nav>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#menu">Menu</a></li>
            <li><a href="#booking">Booking</a></li>
            <li><a href="#gallery">Gallery</a></li>
            <li><a href="#reviews">Reviews</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
</header>

<section id="home" class="hero">
    <h2>Welcome to Tasty Restaurant</h2>
    <p>Delicious Food | Best Quality | Great Experience</p>
</section>

<section id="menu">
    <h2>Our Menu</h2>

    <div class="card">
        <h3>Pizza</h3>
        <p>₹250</p>
    </div>

    <div class="card">
        <h3>Burger</h3>
        <p>₹150</p>
    </div>

    <div class="card">
        <h3>Pasta</h3>
        <p>₹200</p>
    </div>

    <div class="card">
        <h3>Fried Rice</h3>
        <p>₹180</p>
    </div>
</section>

<section id="booking">
    <h2>Online Table Booking</h2>

    <form id="bookingForm">

        <input type="text" id="name" placeholder="Your Name" required>

        <input type="email" id="email" placeholder="Email" required>

        <input type="date" required>

        <input type="time" required>

        <input type="number" placeholder="No. of Persons" required>

        <button type="submit">Book Table</button>

    </form>
</section>

<section id="gallery">
    <h2>Gallery</h2>

    <div class="gallery">
        <img src="https://via.placeholder.com/250x180" alt="">
        <img src="https://via.placeholder.com/250x180" alt="">
        <img src="https://via.placeholder.com/250x180" alt="">
        <img src="https://via.placeholder.com/250x180" alt="">
    </div>

</section>

<section id="reviews">

<h2>Customer Reviews</h2>

<div class="review">
⭐⭐⭐⭐⭐ <br>
"Excellent food and service!"
</div>

<div class="review">
⭐⭐⭐⭐ <br>
"Nice atmosphere and tasty dishes."
</div>

</section>

<section id="contact">

<h2>Contact Us</h2>

<p>📍 Coimbatore, Tamil Nadu</p>
<p>📞 +91 9876543210</p>
<p>✉ tastyrestaurant@gmail.com</p>

</section>

<footer>

<p>© 2026 Tasty Restaurant. All Rights Reserved.</p>

</footer>

<script src="script.js"></script>

</body>
</html>










*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial;
}

body{
background:#f5f5f5;
}

header{
background:#8B0000;
color:white;
padding:15px;
display:flex;
justify-content:space-between;
align-items:center;
}

nav ul{
display:flex;
list-style:none;
}

nav ul li{
margin-left:20px;
}

nav ul li a{
color:white;
text-decoration:none;
font-weight:bold;
}

.hero{
height:300px;
background:orange;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
color:white;
}

section{
padding:40px;
text-align:center;
}

.card{
display:inline-block;
background:white;
width:200px;
padding:20px;
margin:15px;
border-radius:10px;
box-shadow:0 0 10px gray;
}

form{
width:300px;
margin:auto;
}

input,button{
width:100%;
padding:10px;
margin:10px 0;
}

button{
background:#8B0000;
color:white;
border:none;
cursor:pointer;
}

.gallery{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.gallery img{
border-radius:10px;
}

.review{
background:white;
width:300px;
margin:20px auto;
padding:20px;
border-radius:10px;
box-shadow:0 0 10px gray;
}

footer{
background:#8B0000;
color:white;
padding:15px;
text-align:center;
}




document.getElementById("bookingForm").addEventListener("submit", function(e){

e.preventDefault();

let name = document.getElementById("name").value;

alert("Thank You " + name + "! Your table has been booked successfully.");

this.reset();

});
